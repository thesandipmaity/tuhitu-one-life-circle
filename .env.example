# Public browser configuration. Point this at your deployed backend if frontend and API are hosted separately.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WHATSAPP_NUMBER=
VITE_GA_MEASUREMENT_ID=

# Server-only database values for Supabase. Use the service role key only on the backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only payment values. Add through the backend environment, never to client code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Baileys bridge for low-volume WhatsApp Web messaging.
# Run `npm run whatsapp:bridge` in a separate always-on Node process after setting these values.
BAILEYS_BRIDGE_URL=http://127.0.0.1:8788
BAILEYS_BRIDGE_TOKEN=

# Optional WhatsApp registration alerts through Meta WhatsApp Cloud API.
# Create an approved template with one body placeholder, for example:
# "New membership registration received:\n{{1}}"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0

# Optional future recovery-delivery provider values. The current backend securely queues requests.
RESEND_API_KEY=
SMS_PROVIDER_API_KEY=
